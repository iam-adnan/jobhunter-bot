# ============================
# JobHunter Bot Configuration
# ============================

# Discord Bot Token (from Step 3)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID for job alerts (right-click channel → Copy ID)
DISCORD_CHANNEL_ID=your_channel_id_here

# Your Discord User ID (right-click your name → Copy ID)
DISCORD_USER_ID=your_user_id_here

# Claude API Key (from Step 4)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Gmail Settings (from Step 5)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=Your Full Name

# Job Search Preferences
JOB_TITLES=Software Engineer,Full Stack Developer,Backend Developer
JOB_LOCATIONS=Remote,Lahore,Pakistan
JOB_EXPERIENCE_LEVEL=mid,senior
EXCLUDED_COMPANIES=
MIN_SALARY=0

# Schedule (24h format, Pakistan Standard Time)
DAILY_SCAN_TIME=09:00
TIMEZONE=Asia/Karachi

# Ollama Settings (local AI - free)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Paths
MASTER_CV_PATH=./data/master_cv.pdf
MASTER_CV_TEXT_PATH=./data/master_cv.txt
